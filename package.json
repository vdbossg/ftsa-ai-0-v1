{
  "name": "ftsa-ai-0-v1",
  "version": "1.0.0",
  "description": "FTSA AI trading app",
  "author": "Kelvin Mburu Gathuru <kelvinmburug@gmail.com>",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "test": "jest",
    "start": "node server/server.js",
     "postinstall": "npx playwright install",
    "dev": "concurrently \"vite\" \"electron .\"",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "electron-is-dev": "^3.0.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "fs-extra": "^11.3.3",
    "jsonwebtoken": "^9.0.2",
    "lightweight-charts": "^5.0.9",
    "metaapi.cloud-sdk": "^29.3.3",
    "mongoose": "^8.17.2",
    "multer": "^2.0.2",
    "node-binance-api": "^1.0.16",
    "nodemailer": "^7.0.6",
    "playwright": "^1.58.2",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-modal": "^3.16.3",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.3.0",
    "twelvedata": "^3.0.1",
    "ws": "^8.18.3",
    "xml2js": "^0.6.2"
  },
  
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^14.3.1",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^8.46.0",
    "eslint-plugin-react": "^7.33.1",
    "jest": "^29.7.0",
    "vite": "^4.4.0"
  },
  "build": {
    "appId": "com.ftsa.ai",
    "productName": "FTSA AI",
    "npmRebuild": false,
    "asar": false,
    "files": [
      "dist/**/*",
      "server/**/*",
      "main.js",
      "preload.js",
      ".env",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icons/icon4.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon4.ico",
      "uninstallerIcon": "assets/icons/icon4.ico",
      "installerHeaderIcon": "assets/icons/icon4.ico"
    },
    "mac": {
      "icon": "assets/icons/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "assets/icons/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
